# ===================================================
# DOCKER COMPOSE CONFIGURATION & ENVIRONMENT VARIABLES
# Hệ thống Đặt phòng Khách sạn (Hotel Booking System)
# ===================================================

# 1. Cổng Dịch Vụ
BACKEND_PORT=5001
FRONTEND_PORT=5173
DB_PORT=27017
DB_ADMIN_PORT=8081

# 2. Môi Trường
NODE_ENV=production

# 3. Thông Tin Cơ Sở Dữ Liệu (MongoDB)
DB_NAME=hotel_booking_db
DB_USER=hotel_admin
DB_PASSWORD=your_mongodb_password_here

# 4. Công Cụ Quản Lý DB (Mongo-Express)
DB_ADMIN_USER=admin
DB_ADMIN_PASSWORD=your_db_admin_password_here

# 5. Tài Khoản Quản Trị Viên Khách Sạn (Admin Default)
ADMIN_EMAIL=admin@grandpalace.vn
ADMIN_PASSWORD=your_admin_password_here

# 6. Cổng Nginx Reverse Proxy
NGINX_PORT=80
NGINX_SSL_PORT=443

# 7. API URL cho Frontend (Sử dụng đường dẫn tương đối qua Nginx Reverse Proxy)
VITE_API_URL=/api
