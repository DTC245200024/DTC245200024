# ===================================================
# DOCKER COMPOSE CONFIGURATION & ENVIRONMENT VARIABLES
# Hệ thống Đặt phòng Khách sạn (Hotel Booking System)
# Sao chép file này thành .env rồi điền mật khẩu thật. KHÔNG commit file .env.
# Gợi ý sinh mật khẩu ngẫu nhiên:  openssl rand -base64 24 | tr -d '/+=' | cut -c1-24
# ===================================================

# 1. Cổng Dịch Vụ (Chỉ bind 127.0.0.1, không mở ra Internet công khai)
BACKEND_PORT=5001
FRONTEND_PORT=5173
DB_PORT=5432

# 2. Môi Trường
NODE_ENV=production

# 3. Cơ Sở Dữ Liệu PostgreSQL
POSTGRES_DB=hotel_booking_db
POSTGRES_USER=hotel_admin
POSTGRES_PASSWORD=your_postgres_admin_password_here
DB_NAME=hotel_booking_db
# Tài khoản chủ sở hữu CSDL (dùng cho pgAdmin / quản trị)
DB_USER=hotel_admin
DB_PASSWORD=your_postgres_admin_password_here
# Tài khoản ứng dụng cho backend (chỉ có quyền SELECT/INSERT/UPDATE/DELETE)
APP_DB_USER=hotel_app_user
APP_DB_PASSWORD=your_postgres_app_password_here
# Tài khoản chỉ đọc số liệu cho postgres-exporter (role pg_monitor)
EXPORTER_DB_USER=hotel_exporter
EXPORTER_DB_PASSWORD=your_postgres_exporter_password_here
# Lưu ý: các role trên chỉ được tạo khi volume pg_data còn trống (lần khởi tạo đầu tiên).

# 4. Công Cụ Quản Lý DB (pgAdmin 4) - chỉ mở trên 127.0.0.1
PGADMIN_PORT=5050
# Phải là email hợp lệ (không dùng đuôi .local)
PGADMIN_DEFAULT_EMAIL=pgadmin@grandpalace.vn
PGADMIN_DEFAULT_PASSWORD=your_pgadmin_password_here

# 5. Tài Khoản Quản Trị Viên Khách Sạn
# Chỉ dùng khi chạy thủ công: docker compose exec backend npm run create-admin
ADMIN_EMAIL=admin@grandpalace.vn
ADMIN_PASSWORD=your_admin_password_here

# 6. Cổng Nginx Reverse Proxy
NGINX_PORT=80
NGINX_SSL_PORT=443

# 7. API URL cho Frontend (Sử dụng đường dẫn tương đối qua Nginx Reverse Proxy)
VITE_API_URL=/api

# 8. Cấu hình Giám Sát (Prometheus & Grafana)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_grafana_password_here

# 9. Cấu hình Hệ Thống Log Tập Trung (Loki & Promtail)
LOKI_PORT=3100
