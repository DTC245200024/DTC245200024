# ===================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG BACKEND (RENDER HOẶC LOCAL)
# ===================================================

# Cổng khởi chạy server (Render sẽ tự động cung cấp biến PORT này)
PORT=5001

# Môi trường chạy: 'production' hoặc 'development'
NODE_ENV=production

# URL Frontend đã triển khai (dùng cho CORS khi triển khai tách riêng 2 service)
# Ví dụ: https://my-hotel.onrender.com hoặc https://my-hotel.vercel.app
CLIENT_URL=

# Thông tin tài khoản Quản Trị Viên (System Admin) mặc định
# Giúp bảo mật thông tin, không để lộ mật khẩu trong code
ADMIN_EMAIL=admin@grandpalace.vn
ADMIN_PASSWORD=your_admin_password_here
