# ===================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG BACKEND (RENDER HOẶC LOCAL)
# ===================================================

# Cổng khởi chạy server
PORT=5001

# Môi trường chạy: 'production' hoặc 'development'
NODE_ENV=production

# URL Frontend đã triển khai (dùng cho CORS khi triển khai tách riêng 2 service)
CLIENT_URL=

# Kết nối PostgreSQL (khi chạy ngoài Docker). Trong Docker Compose các biến này được truyền tự động.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=hotel_booking_db
APP_DB_USER=hotel_app_user
APP_DB_PASSWORD=your_postgres_app_password_here
# Hoặc dùng một chuỗi kết nối duy nhất (ưu tiên hơn các biến trên nếu có):
# DATABASE_URL=postgresql://user:password@host:5432/hotel_booking_db

# Dùng cho lệnh thủ công `npm run create-admin` (không tự tạo khi khởi động)
ADMIN_EMAIL=admin@grandpalace.vn
ADMIN_PASSWORD=your_admin_password_here
